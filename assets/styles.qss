/* Modern Dark/Sleek Theme for Mentor Report Generator (PySide6) */

QMainWindow {
    background-color: #0F172A;
    color: #F8FAFC;
    font-family: 'Segoe UI', Arial, sans-serif;
}

QWidget {
    color: #F8FAFC;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
}

/* Sidebar Navigation */
#SidebarFrame {
    background-color: #1E293B;
    border-right: 1px solid #334155;
    min-width: 220px;
    max-width: 220px;
}

#SidebarTitle {
    font-size: 16px;
    font-weight: bold;
    color: #818CF8;
    padding: 15px 10px;
}

QPushButton.nav-btn {
    background-color: transparent;
    color: #94A3B8;
    border: none;
    border-radius: 8px;
    padding: 12px 16px;
    text-align: left;
    font-size: 14px;
    font-weight: 600;
}

QPushButton.nav-btn:hover {
    background-color: #334155;
    color: #F8FAFC;
}

QPushButton.nav-btn:checked, QPushButton.nav-btn.active {
    background-color: #4F46E5;
    color: #FFFFFF;
}

/* Cards & Frames */
QFrame.card {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 16px;
}

QFrame.card-highlight {
    background-color: #1E1B4B;
    border: 1px solid #6366F1;
    border-radius: 12px;
    padding: 16px;
}

/* Labels & Typography */
QLabel.heading-1 {
    font-size: 22px;
    font-weight: bold;
    color: #F8FAFC;
}

QLabel.heading-2 {
    font-size: 16px;
    font-weight: bold;
    color: #C7D2FE;
}

QLabel.metric-value {
    font-size: 26px;
    font-weight: bold;
    color: #818CF8;
}

QLabel.metric-label {
    font-size: 12px;
    color: #94A3B8;
    text-transform: uppercase;
}

/* Buttons */
QPushButton.btn-primary {
    background-color: #4F46E5;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton.btn-primary:hover {
    background-color: #6366F1;
}

QPushButton.btn-secondary {
    background-color: #334155;
    color: #F8FAFC;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 600;
}

QPushButton.btn-secondary:hover {
    background-color: #475569;
}

QPushButton.btn-success {
    background-color: #059669;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
}

QPushButton.btn-success:hover {
    background-color: #10B981;
}

QPushButton.btn-danger {
    background-color: #DC2626;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
}

QPushButton.btn-danger:hover {
    background-color: #EF4444;
}

/* LineEdits & TextEdits */
QLineEdit, QTextEdit, QComboBox {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 8px;
    color: #F8FAFC;
    padding: 8px 12px;
    selection-background-color: #6366F1;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #818CF8;
}

/* Tables */
QTableWidget {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 8px;
    gridline-color: #1E293B;
    color: #F8FAFC;
}

QHeaderView::section {
    background-color: #1E293B;
    color: #C7D2FE;
    padding: 8px;
    border: none;
    font-weight: bold;
}

QTableWidget::item:selected {
    background-color: #312E81;
    color: #FFFFFF;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #0F172A;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #334155;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #475569;
}
